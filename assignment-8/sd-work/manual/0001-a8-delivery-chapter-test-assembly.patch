 \newglossaryentry{grafana}{name={Grafana},description={An open-source tool that draws dashboards from stored metrics and evaluates alert rules, sending notifications to a contact point}}
 \newglossaryentry{exporter}{name={exporter},description={A small program that exposes metrics of a host or service in the format Prometheus scrapes; here Node Exporter (the host) and Blackbox Exporter (probes)}}
 \newglossaryentry{probe}{name={probe},description={A scheduled test request made from outside a service, such as an HTTPS request to a login page, whose result is recorded as 1 (success) or 0 (failure)}}
+\newglossaryentry{imagedigest}{name={image digest},description={The SHA-256 identifier of one exact container image in a registry (\texttt{name@sha256:...}); unlike a tag it cannot be moved to another image}}
+\newglossaryentry{releaserecord}{name={release record},description={A small YAML file per release and environment that names the image digest, source commit, expected version and total, URL and, for production, the approval; Ansible deploys exactly what it names}}
+\newglossaryentry{release}{name={release},description={One reviewed source commit built into one image and deployed to staging and, after approval, to production}}
+\newglossaryentry{staging}{name={staging},description={The environment that receives every new release first so it can be checked before anyone approves production}}
+\newglossaryentry{promotion}{name={promotion},description={Deploying to production the same image digest that staging tested, after a named approval; nothing is rebuilt}}
+\newglossaryentry{idempotent}{name={idempotent},description={Of an automation run: running it again with the same input changes nothing (Ansible reports \texttt{changed=0})}}
+\newglossaryentry{trustedagent}{name={trusted agent},description={The Jenkins agent that alone holds deployment credentials and runs the delivery stages, only for the protected \texttt{main} branch}}
