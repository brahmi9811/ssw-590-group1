# Caddy gets and renews Let's Encrypt certificates for both names and redirects HTTP to HTTPS.
# Jenkins: the team reaches everything; the public reaches only the login page and the GitHub
# webhook path (GitHub's addresses change, so the webhook is protected by its shared secret,
# not by an address list).
{$PIPELINE_DOMAIN} {
	@team remote_ip {$TEAM_IPS}
	@public path /login /login/* /static/* /adjuncts/* /favicon.ico /github-webhook/

	handle @team {
		reverse_proxy jenkins:8080
	}
	handle @public {
		reverse_proxy jenkins:8080
	}
	handle {
		respond "Forbidden" 403
	}
}

# Grafana: team only, plus the login page. Add the instructor's address to TEAM_IPS for the demo if needed.
{$LOAD_DOMAIN} {
	@team remote_ip {$TEAM_IPS}
	@loginpage path /login /public/* /api/health /favicon.ico

	handle @team {
		reverse_proxy grafana:3000
	}
	handle @loginpage {
		reverse_proxy grafana:3000
	}
	handle {
		respond "Forbidden" 403
	}
}
